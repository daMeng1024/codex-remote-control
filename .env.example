# Generate with: npm run password:hash -w @codex-remote/server -- "your-long-password"
REMOTE_PASSWORD_HASH=scrypt$replace-with-generated-hash
SESSION_SECRET=replace-with-at-least-32-random-characters
BIND_HOST=127.0.0.1
PORT=8787
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8787
WORKSPACE_ROOT=/home/epean/code
COOKIE_SECURE=false
CODEX_BIN=/home/epean/.local/bin/codex
# Required for a non-loopback production bind. Must equal BIND_HOST and be locally assigned.
ZEROTIER_ADDRESS=
